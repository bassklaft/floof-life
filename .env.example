# RevenueCat iOS public SDK key (NOT a secret — safe to embed in client builds,
# but kept out of git so test/prod values don't get crossed by accident).
# Find this in the RevenueCat dashboard → Project settings → API keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Android public key — leave blank until Android ships.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AI Floof Assistant proxy URL. Points the client at our Supabase Edge
# Function (see /supabase/functions/ai-floof-assistant/). The function
# is the ONLY place that talks to Anthropic — the client never holds
# the Anthropic key. If unset, the Floof Assistant screen shows a
# "not yet configured" message.
EXPO_PUBLIC_AI_PROXY_URL=

# Churn-feedback Edge Function URL (see /supabase/functions/churn-feedback/).
# Receives the cancellation / non-conversion feedback form. The client
# never holds a database credential — it only POSTs to this endpoint.
# While this is unset the in-app churn-feedback prompt stays dormant.
# After deploying, set it to:
#   https://<project-ref>.supabase.co/functions/v1/churn-feedback
EXPO_PUBLIC_CHURN_FEEDBACK_URL=

# ─── Accounts + cloud sync (v2.0) ──────────────────────────────────
# Supabase project URL + anon (public) key. The anon key is safe to
# ship in the client per supabase docs — RLS policies enforce per-user
# access. Service-role key NEVER ships in the client (it lives only in
# Edge Functions). Find these in Supabase dashboard → Project settings
# → API. While these are unset, the AuthProvider returns
# `configured: false` and the in-app Account screen shows a "not yet
# configured" state — the rest of the app keeps working fully local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
